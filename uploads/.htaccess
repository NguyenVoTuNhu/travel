# Thư mục tệp tải lên: không liệt kê, không chạy mã.
Options -Indexes -ExecCGI

<IfModule mod_php.c>
  php_flag engine off
</IfModule>

<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

<FilesMatch "\.(?i:php|phtml|phar|html?|js|svg)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
